node_modules/
dist/
build/
.output/
.svelte-kit/
coverage/
*.log
.DS_Store
.env
.env.*
!.env.example
!.env.dev.example
# .env.dev.local (scripts/dev.sh's local dev loop config) is covered by the
# .env.* pattern above like every other real .env file - never committed.
.turbo/
.pnpm-store/

# Relay backup artifacts land here on the host (deploy/relay/docker-compose.yml
# bind mount, #103) - encrypted, but still never committed.
deploy/relay/backups/

# `pnpm package:node-release` output (issue #817) — built per-run by CI, never committed.
/release/

# `apps/desktop`'s electron-builder output (issue #866: now per-environment,
# `apps/desktop/release/{production,preview}/`) — built per-run locally or in
# CI, never committed. Pre-existing gap the above root-anchored `/release/`
# never covered, since it only matches the repo root.
apps/desktop/release/

# Ephemeral agent/orchestration worktrees (Workflow tool, emdash)
.claude/worktrees/
.emdash/worktrees/

# temporary UI-audit artifacts (redesign v3)
apps/web/.audit/
apps/web/test-results/
apps/web/playwright-report/
apps/web/tests-e2e/zz-audit-screens.spec.ts

# `apps/mobile`'s native shells (issue #281's spike): `cap add android`/
# `cap add ios` generates a full native project (Gradle module,
# Xcode project + CocoaPods) from `capacitor.config.ts` + `www/` on demand.
# Nothing in either tree is hand-edited yet (no plugin, no native code), so
# regenerating loses nothing — the moment that stops being true, the tree
# has to come out of this ignore and become real source, or edits get
# silently discarded by the next `cap add`/`cap sync`.
apps/mobile/android/
apps/mobile/ios/

# `apps/mobile/scripts/build-www.mjs`'s esbuild output — `www/index.html` is
# hand-written and stays tracked, `diagnostics.js`(.map) is generated from
# `src/` on every `build` and never hand-edited.
apps/mobile/www/diagnostics.js
apps/mobile/www/diagnostics.js.map
