#!/usr/bin/env bash
# Reformats staged .changeset/*.md files with Prettier before they can land in a
# commit, so a changeset is never the reason CI's `pnpm format:check` goes red
# (see issue #723: three PRs lost a full CI round trip to exactly this).
#
# Installed automatically by `pnpm install` via the root "prepare" script
# (`git config core.hooksPath .githooks`) — nothing to set up per clone.
# Skip on purpose with `git commit --no-verify`.
set -euo pipefail

cd "$(git rev-parse --show-toplevel)"

mapfile -d '' staged < <(
  git diff --cached --name-only --diff-filter=ACM -z -- '.changeset/*.md' |
    grep -zv '^\.changeset/README\.md$' || true
)

[ "${#staged[@]}" -eq 0 ] && exit 0

if ! pnpm exec prettier --check "${staged[@]}" >/dev/null 2>&1; then
  echo "pre-commit: reformatting unformatted changeset(s) with Prettier:"
  printf '  %s\n' "${staged[@]}"
  pnpm exec prettier --write "${staged[@]}"
  git add "${staged[@]}"
fi
