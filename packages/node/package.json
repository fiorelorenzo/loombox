{
  "name": "@loombox/node",
  "version": "0.10.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "types": "./src/index.ts",
  "scripts": {
    "build": "tsc --noEmit",
    "pretypecheck": "node ../../scripts/check-worktree-leak.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "start": "tsx src/main.ts",
    "dev": "tsx watch src/main.ts",
    "bundle": "node scripts/bundle.mjs"
  },
  "dependencies": {
    "@loombox/crypto": "workspace:*",
    "@loombox/protocol": "workspace:*",
    "@loombox/providers-core": "workspace:*",
    "@loombox/shared": "workspace:*",
    "@loombox/supervisor": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@napi-rs/keyring": "^1.3.0",
    "check-disk-space": "^3.4.0",
    "ssh2": "^1.16.0",
    "zod": "^3.23.8",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@loombox/relay": "workspace:*",
    "@types/ssh2": "^1.15.1",
    "tsx": "^4.19.1"
  }
}
