# loombox relay PREVIEW env (copy to `.env` next to this file, chmod 600,
# never commit). Mirrors ../relay/.env.example (production) - read that
# file's comments for anything not repeated here. The real .env lives only
# on the host, at /opt/apps/loombox-preview/deploy/relay-preview/.env.
#
# Every value below must be preview's own. None of these may be copied from
# production's .env: a shared BETTER_AUTH_SECRET makes a production session
# token valid on preview, and a shared Postgres password only matters if
# someone also points DATABASE_URL at production's container - don't; this
# compose project has its own postgres service and its own named volume for
# exactly that reason (#864).

# Postgres password for the compose-managed preview database. Generate a
# fresh one - do not reuse production's.
POSTGRES_PASSWORD=change-me

# Better Auth signing secret for preview. Generate a fresh one:
# openssl rand -base64 48
# Reusing production's would mean a production login session is also a
# valid preview session, which is exactly the isolation failure #863 exists
# to prevent.
BETTER_AUTH_SECRET=change-me

# Public origin preview is served on. Must match the registered OAuth
# callback host below.
RELAY_PUBLIC_URL=https://preview-relay.loombox.dev

# The preview web app's origin - never production's app.loombox.dev.
LOOMBOX_TRUSTED_ORIGINS=https://preview.loombox.dev
LOOMBOX_APP_URL=https://preview.loombox.dev

# Preview's OWN GitHub OAuth App (Settings > Developer settings > OAuth
# Apps > New OAuth App on whichever GitHub account owns this - see
# docs/deploy-relay.md's "Preview environment" section for the exact
# walkthrough). This cannot be automated: GitHub has no API to create an
# OAuth App, only the web UI. Authorization callback URL must be exactly:
#   https://preview-relay.loombox.dev/api/auth/callback/github
#
# Leave these two lines commented out - not set to a placeholder string -
# until you have real values. docker-compose.yml requires both with no
# default, so `docker compose up` refuses to start with a clear "required
# variable GITHUB_CLIENT_ID is missing a value" error while they're absent,
# rather than booting with a dead login button nobody notices until they
# try to sign in. A literal string like "change-me" would NOT trigger that
# guard - compose only treats a variable as missing when it's truly unset,
# so leave the lines commented rather than filled with a placeholder.
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# Google OAuth: intentionally not offered on preview (see
# docker-compose.yml's comment) - nothing to set here.

# Preview has no automated nightly backup (see docker-compose.yml's comment
# on the relay service's backups volume), so RELAY_BACKUP_ENCRYPTION_KEY /
# RELAY_BACKUP_RETENTION_COUNT from production's .env.example don't apply
# here.
