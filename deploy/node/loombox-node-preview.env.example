# loombox resident node env — PREVIEW environment (issue #867, epic #863).
# Copy to loombox-node-preview.env, chmod 600, never commit. Mirrors
# ./loombox-node.env.example (production) — read that file's comments for
# anything not repeated here.
#
# Every value below must be preview's own — never copied from the
# production env file. LOOMBOX_NODE_STATE_DIR/LOOMBOX_NODE_ID in particular:
# leaving either at production's value is exactly the collision issue #867
# describes (one identity fought over by two processes, two rows in the
# node list both called the same thing). packages/node/src/node-environment.ts
# names the same `.loombox-preview` convention this file uses by hand, for
# the automated local-provisioning path — this manual file just applies it
# explicitly, since main.ts itself has no "which environment" flag to
# derive it from.

# Preview's own relay — never production's relay.loombox.dev.
LOOMBOX_RELAY_URL=wss://preview-relay.loombox.dev

# A distinct id from the production node's LOOMBOX_NODE_ID (see
# ./loombox-node.env.example) — otherwise the two are indistinguishable
# rows in the account's node list. This convention just appends the
# environment.
LOOMBOX_NODE_ID=devbox-preview

# Optional: this device's id, separate from LOOMBOX_NODE_ID. Defaults to
# LOOMBOX_NODE_ID (a CLI-run node is a single device) - only set this if you
# need the two to differ.
# LOOMBOX_DEVICE_ID=

# This node's bearer token, authorizing it against PREVIEW's Better Auth as
# a device of a preview account. Preview has its own GitHub OAuth App and
# its own Postgres (docs/deploy-relay.md's "Preview environment" section) —
# a production account/session has no meaning here, this must be a real
# account created against preview. See ./README.md's "Get a device token"
# step, run against LOOMBOX_RELAY_URL above.
LOOMBOX_AUTH_TOKEN=

# Optional: pin the account this node's sessions are scoped under. Leave
# unset and the node resolves it from LOOMBOX_AUTH_TOKEN itself via the
# relay - the normal path; only set this to override.
# LOOMBOX_ACCOUNT_ID=

# Exactly one of LOOMBOX_RECOVERY_CODE / LOOMBOX_AMK is required, so the
# node can get at this preview account's E2E Account Master Key. Same
# mechanism as production's own — see ./loombox-node.env.example — but the
# Recovery Code itself must come from the preview web app
# (https://preview.loombox.dev, Settings > Recovery Code), not
# app.loombox.dev: preview's AMK/account are entirely separate from
# production's (#863/#868's isolation), so production's Recovery Code does
# not unlock anything here.
LOOMBOX_RECOVERY_CODE=

# LOOMBOX_AMK is a raw base64-encoded 256-bit key, only meant as an escape
# hatch for tests/advanced use - wins over LOOMBOX_RECOVERY_CODE if both are
# set. Leave unset on a normal deploy.
# LOOMBOX_AMK=

# Optional: extra execution targets beyond the always-available `local`
# one, as a JSON array of TargetDescriptor (see packages/protocol). Leave
# unset to expose only `local` (running sessions directly on this host).
# LOOMBOX_TARGETS=[]

# REQUIRED here (unlike production's own file, where this is optional and
# defaults to ~/.loombox/node): this is the one setting that keeps this
# node's identity/session state from sharing production's
# ~/.loombox/node — set it to an absolute path under a SEPARATE tree.
# packages/node/src/node-environment.ts's own convention for this is
# ~/.loombox-preview/node; substitute this host's real home directory,
# EnvironmentFile= does no ~ or $HOME expansion.
LOOMBOX_NODE_STATE_DIR=/home/dev/.loombox-preview/node

# Required by the spawned Claude Code ACP agent itself - see
# ./loombox-node.env.example's own comment. Preview's node needs its own
# working `claude setup-token` credential exactly like production's does;
# reusing the same token for both is fine (it authenticates against
# Anthropic, not against loombox), but each systemd unit still needs it set
# in its own env file.
CLAUDE_CODE_OAUTH_TOKEN=
